---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const caminhos = [
  'Leis de incentivo fiscal',
  'Recurso público e editais',
  'Patrocínio e captação privada',
  'Crédito e investidores',
  'Renda própria',
  'Habilitações e certificações',
  'Prestação de contas',
];
---

<section class="relative overflow-hidden bg-navy-900 pb-20 pt-32 text-white sm:pb-28 sm:pt-40">
  {/* textura decorativa sutil de fundo, só visual */}
  <div class="pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-grid" width="56" height="56" patternUnits="userSpaceOnUse">
          <path d="M 56 0 L 0 0 0 56" fill="none" stroke="white" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)"/>
    </svg>
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[1.15fr_1fr] lg:gap-10">
    <div data-reveal-group>
      <p data-reveal class="text-sm font-semibold uppercase tracking-widest text-emerald-400">
        Consultoria em captação de recursos
      </p>
      <h1 data-reveal class="mt-5 max-w-xl font-heading text-4xl font-extrabold leading-[1.1] sm:text-5xl">
        Transformamos sua ideia em <span class="text-emerald-400">recurso captado</span>
      </h1>
      <p data-reveal class="mt-6 max-w-lg text-lg leading-relaxed text-white/75">
        Elaboramos projetos para lei de incentivo, recurso público, patrocínio, crédito e outras formas de
        captação — para OSCs, empresas e pessoas físicas. Também temos o Data10 Recursos, sistema que conduz esse
        processo etapa por etapa, e desenvolvemos sites e aplicativos sob medida.
      </p>
      <div data-reveal class="mt-9 flex flex-wrap gap-4">
        <a
          href={`${base}/contato/`}
          class="rounded-[--radius-control] bg-emerald-500 px-6 py-3.5 text-sm font-semibold text-navy-900 shadow-[0_8px_24px_rgba(16,185,129,0.35)] transition-colors hover:bg-emerald-600"
        >
          Agendar diagnóstico
        </a>
        <a
          href={`${base}/servicos-captacao/`}
          class="rounded-[--radius-control] border border-white/30 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/5"
        >
          Conheça os serviços
        </a>
      </div>
    </div>

    <div class="relative">
      <div class="relative aspect-[4/5] w-full overflow-hidden rounded-[--radius-card] border border-white/10 bg-navy-900 shadow-2xl">
        <video
          class="hero-network-video h-full w-full object-cover"
          poster={`${base}/images/hero-video-poster.jpg`}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        >
          <source src={`${base}/videos/hero-rede-digital.mp4`} type="video/mp4" />
        </video>

        {/* nó central sobreposto: o recurso captado, no ponto de fuga do vídeo */}
        <div class="hero-dollar-badge pointer-events-none absolute left-[49%] top-[46%] flex h-[54px] w-[54px] -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-white/40 bg-emerald-500 font-heading text-2xl font-extrabold text-navy-900 shadow-[0_0_30px_rgba(16,185,129,0.6)]">
          $
        </div>
      </div>

      {/* card flutuante */}
      <div class="absolute -bottom-8 -left-6 w-[88%] rounded-[--radius-card] border border-white/10 bg-white p-5 text-ink-900 shadow-2xl sm:-left-10 sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">7 caminhos de captação</p>
        <ul class="mt-3 grid grid-cols-1 gap-y-1.5 text-sm text-ink-500 sm:grid-cols-2 sm:gap-x-4">
          {caminhos.map((c) => (
            <li class="flex items-center gap-1.5">
              <span class="h-1 w-1 shrink-0 rounded-full bg-emerald-500"></span>
              {c}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-dollar-badge {
      animation: hero-dollar-pulse 3s ease-in-out infinite;
    }
  }

  @keyframes hero-dollar-pulse {
    0%,
    100% {
      opacity: 0.9;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.08);
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('.hero-network-video');
  if (video && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    video.setAttribute('preload', 'auto');
    video.play().catch(() => {
      // autoplay pode falhar em alguns navegadores/condições — o poster
      // (primeiro quadro já com o filtro de cor) continua visível, sem quebrar nada.
    });
  }
</script>
