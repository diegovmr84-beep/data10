---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// malha de fundo do grafo do hero: posição dos nós gerada com semente fixa
// (reprodutível a cada build), conectados aos vizinhos mais próximos — estilo
// "plexus" de rede digital, inspirado em referência enviada pelo usuário.
function mulberry32(seed: number) {
  return function random() {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const random = mulberry32(42);
const plexusNodes = Array.from({ length: 26 }, () => ({
  x: Math.round(random() * 380) + 10,
  y: Math.round(random() * 460) + 15,
}));

const plexusEdges: { key: string; x1: number; y1: number; x2: number; y2: number }[] = [];
const MAX_NEIGHBOR_DIST = 115;
plexusNodes.forEach((node, i) => {
  const nearest = plexusNodes
    .map((other, j) => ({ j, dist: Math.hypot(other.x - node.x, other.y - node.y) }))
    .filter(({ j, dist }) => j !== i && dist < MAX_NEIGHBOR_DIST)
    .sort((a, b) => a.dist - b.dist)
    .slice(0, 3);
  for (const { j } of nearest) {
    const key = i < j ? `${i}-${j}` : `${j}-${i}`;
    if (!plexusEdges.some((e) => e.key === key)) {
      plexusEdges.push({ key, x1: node.x, y1: node.y, x2: plexusNodes[j].x, y2: plexusNodes[j].y });
    }
  }
});

const caminhos = [
  'Leis de incentivo fiscal',
  'Recurso público e editais',
  'Patrocínio e captação privada',
  'Crédito e investidores',
  'Renda própria',
  'Habilitações e certificações',
  'Prestação de contas',
];
---

<section class="relative overflow-hidden bg-navy-900 pb-20 pt-32 text-white sm:pb-28 sm:pt-40">
  {/* textura decorativa sutil de fundo, só visual */}
  <div class="pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-grid" width="56" height="56" patternUnits="userSpaceOnUse">
          <path d="M 56 0 L 0 0 0 56" fill="none" stroke="white" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)"/>
    </svg>
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[1.15fr_1fr] lg:gap-10">
    <div data-reveal-group>
      <p data-reveal class="text-sm font-semibold uppercase tracking-widest text-emerald-400">
        Consultoria em captação de recursos
      </p>
      <h1 data-reveal class="mt-5 max-w-xl font-heading text-4xl font-extrabold leading-[1.1] sm:text-5xl">
        Transformamos sua ideia em <span class="text-emerald-400">recurso captado</span>
      </h1>
      <p data-reveal class="mt-6 max-w-lg text-lg leading-relaxed text-white/75">
        Elaboramos projetos para lei de incentivo, recurso público, patrocínio, crédito e outras formas de
        captação — para OSCs, empresas e pessoas físicas. Também temos o Data10 Recursos, sistema que conduz esse
        processo etapa por etapa, e desenvolvemos sites e aplicativos sob medida.
      </p>
      <div data-reveal class="mt-9 flex flex-wrap gap-4">
        <a
          href={`${base}/contato/`}
          class="rounded-[--radius-control] bg-emerald-500 px-6 py-3.5 text-sm font-semibold text-navy-900 shadow-[0_8px_24px_rgba(16,185,129,0.35)] transition-colors hover:bg-emerald-600"
        >
          Agendar diagnóstico
        </a>
        <a
          href={`${base}/servicos-captacao/`}
          class="rounded-[--radius-control] border border-white/30 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/5"
        >
          Conheça os serviços
        </a>
      </div>
    </div>

    <div class="relative">
      <div class="aspect-[4/5] w-full overflow-hidden rounded-[--radius-card] border border-white/10 bg-gradient-to-br from-navy-700 via-navy-800 to-navy-900 shadow-2xl">
        <svg class="network-graphic h-full w-full" viewBox="0 0 400 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <radialGradient id="hub-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#34d399" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#34d399" stop-opacity="0" />
            </radialGradient>
          </defs>

          {/* malha de fundo: rede digital densa, estilo plexus */}
          <g stroke="#34d399" stroke-width="1" fill="none">
            {plexusEdges.map((e, i) => (
              <path
                class="plexus-line"
                stroke-opacity={0.1 + (i % 5) * 0.025}
                d={`M${e.x1},${e.y1} L${e.x2},${e.y2}`}
                style={`animation-delay:${(i % 12) * 0.35}s`}
              />
            ))}
          </g>
          <g fill="white">
            {plexusNodes.map((n, i) => (
              <circle class="plexus-node" cx={n.x} cy={n.y} r={1.4 + (i % 3) * 0.5} fill-opacity="0.55" style={`animation-delay:${(i % 9) * 0.4}s`} />
            ))}
          </g>

          <circle class="network-hub-glow" cx="200" cy="230" r="110" fill="url(#hub-glow)" />

          {/* linhas orgânicas, estilo mapa mental, das etapas até o resultado */}
          <g stroke="#34d399" stroke-width="2" stroke-opacity="0.45" fill="none">
            <path class="network-line" d="M85,95 Q130,190 200,230" />
            <path class="network-line" d="M315,85 Q260,180 200,230" style="animation-delay:.5s" />
            <path class="network-line" d="M340,250 Q275,240 200,230" style="animation-delay:1s" />
            <path class="network-line" d="M70,275 Q130,260 200,230" style="animation-delay:1.5s" />
          </g>

          {/* nó central: o recurso captado */}
          <circle cx="200" cy="230" r="27" fill="#10b981" />
          <circle cx="200" cy="230" r="27" fill="none" stroke="white" stroke-opacity="0.4" stroke-width="1.5" />
          <text
            x="200"
            y="231"
            text-anchor="middle"
            dominant-baseline="central"
            font-family="'Plus Jakarta Sans', Arial, sans-serif"
            font-weight="800"
            font-size="28"
            fill="#0b1f3a"
          >$</text>

          {/* etapas da produção do projeto */}
          <g>
            <circle class="network-node" cx="85" cy="95" r="6" fill="#34d399" />

            <circle class="network-node" cx="315" cy="85" r="6" fill="#34d399" style="animation-delay:.5s" />

            <circle class="network-node" cx="340" cy="250" r="6" fill="#34d399" style="animation-delay:1s" />

            <circle class="network-node" cx="70" cy="275" r="6" fill="#34d399" style="animation-delay:1.5s" />
          </g>
        </svg>
      </div>

      {/* card flutuante */}
      <div class="absolute -bottom-8 -left-6 w-[88%] rounded-[--radius-card] border border-white/10 bg-white p-5 text-ink-900 shadow-2xl sm:-left-10 sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">7 caminhos de captação</p>
        <ul class="mt-3 grid grid-cols-1 gap-y-1.5 text-sm text-ink-500 sm:grid-cols-2 sm:gap-x-4">
          {caminhos.map((c) => (
            <li class="flex items-center gap-1.5">
              <span class="h-1 w-1 shrink-0 rounded-full bg-emerald-500"></span>
              {c}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .network-line {
    stroke-dasharray: 6 6;
  }
  .network-node {
    transform-origin: center;
    transform-box: fill-box;
  }
  .network-hub-glow {
    transform-origin: center;
    transform-box: fill-box;
  }
  .plexus-node {
    transform-origin: center;
    transform-box: fill-box;
  }

  @media (prefers-reduced-motion: no-preference) {
    .network-line {
      animation: network-dash-flow 8s linear infinite;
    }
    .network-node {
      animation: network-node-pulse 3s ease-in-out infinite;
    }
    .network-hub-glow {
      animation: network-hub-pulse 3s ease-in-out infinite;
    }
    .plexus-line {
      animation: plexus-twinkle 5s ease-in-out infinite;
    }
    .plexus-node {
      animation: plexus-node-twinkle 4s ease-in-out infinite;
    }
  }

  @keyframes plexus-twinkle {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes plexus-node-twinkle {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.4);
    }
  }

  @keyframes network-hub-pulse {
    0%,
    100% {
      opacity: 0.8;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  @keyframes network-dash-flow {
    to {
      stroke-dashoffset: -120;
    }
  }

  @keyframes network-node-pulse {
    0%,
    100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.25);
    }
  }
</style>
