---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const caminhos = [
  'Leis de incentivo fiscal',
  'Recurso público e editais',
  'Patrocínio e captação privada',
  'Crédito e investidores',
  'Renda própria',
  'Habilitações e certificações',
  'Prestação de contas',
];
---

<section class="relative overflow-hidden bg-navy-900 pb-20 pt-32 text-white sm:pb-28 sm:pt-40">
  {/* textura decorativa sutil de fundo, só visual */}
  <div class="pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-grid" width="56" height="56" patternUnits="userSpaceOnUse">
          <path d="M 56 0 L 0 0 0 56" fill="none" stroke="white" stroke-width="1"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-grid)"/>
    </svg>
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[1.15fr_1fr] lg:gap-10">
    <div data-reveal-group>
      <p data-reveal class="text-sm font-semibold uppercase tracking-widest text-emerald-400">
        Consultoria em captação de recursos
      </p>
      <h1 data-reveal class="mt-5 max-w-xl font-heading text-4xl font-extrabold leading-[1.1] sm:text-5xl">
        Transformamos sua ideia em <span class="text-emerald-400">recurso captado</span>
      </h1>
      <p data-reveal class="mt-6 max-w-lg text-lg leading-relaxed text-white/75">
        Elaboramos projetos para lei de incentivo, recurso público, patrocínio, crédito e outras formas de
        captação — para OSCs, empresas e pessoas físicas. Também temos o Data10 Recursos, sistema que conduz esse
        processo etapa por etapa, e desenvolvemos sites e aplicativos sob medida.
      </p>
      <div data-reveal class="mt-9 flex flex-wrap gap-4">
        <a
          href={`${base}/contato/`}
          class="rounded-[--radius-control] bg-emerald-500 px-6 py-3.5 text-sm font-semibold text-navy-900 shadow-[0_8px_24px_rgba(16,185,129,0.35)] transition-colors hover:bg-emerald-600"
        >
          Agendar diagnóstico
        </a>
        <a
          href={`${base}/servicos-captacao/`}
          class="rounded-[--radius-control] border border-white/30 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/5"
        >
          Conheça os serviços
        </a>
      </div>
    </div>

    <div data-reveal class="relative">
      <div class="aspect-[4/5] w-full overflow-hidden rounded-[--radius-card] border border-white/10 bg-gradient-to-br from-navy-700 via-navy-800 to-navy-900 shadow-2xl">
        <svg class="network-graphic h-full w-full" viewBox="0 0 400 500" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <radialGradient id="hub-glow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#34d399" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#34d399" stop-opacity="0" />
            </radialGradient>
          </defs>

          <circle cx="200" cy="210" r="100" fill="url(#hub-glow)" />

          <g stroke="#34d399" stroke-width="1.5" stroke-opacity="0.4" fill="none">
            <path class="network-line" d="M200,210 L90,110" />
            <path class="network-line" d="M200,210 L200,70" style="animation-delay:.3s" />
            <path class="network-line" d="M200,210 L300,90" style="animation-delay:.6s" />
            <path class="network-line" d="M200,210 L340,220" style="animation-delay:.9s" />
            <path class="network-line" d="M200,210 L280,330" style="animation-delay:1.2s" />
            <path class="network-line" d="M200,210 L120,340" style="animation-delay:1.5s" />
            <path class="network-line" d="M200,210 L60,230" style="animation-delay:1.8s" />
          </g>
          <g stroke="#34d399" stroke-width="1" stroke-opacity="0.2" fill="none">
            <path d="M90,110 L200,70" />
            <path d="M300,90 L340,220" />
            <path d="M120,340 L60,230" />
          </g>

          <circle cx="200" cy="210" r="11" fill="#34d399" />
          <circle cx="200" cy="210" r="11" fill="none" stroke="white" stroke-opacity="0.4" stroke-width="1.5" />

          <g fill="#34d399">
            <circle class="network-node" cx="90" cy="110" r="5" />
            <circle class="network-node" cx="200" cy="70" r="5" style="animation-delay:.3s" />
            <circle class="network-node" cx="300" cy="90" r="5" style="animation-delay:.6s" />
            <circle class="network-node" cx="340" cy="220" r="5" style="animation-delay:.9s" />
            <circle class="network-node" cx="280" cy="330" r="5" style="animation-delay:1.2s" />
            <circle class="network-node" cx="120" cy="340" r="5" style="animation-delay:1.5s" />
            <circle class="network-node" cx="60" cy="230" r="5" style="animation-delay:1.8s" />
          </g>
        </svg>
      </div>

      {/* card flutuante */}
      <div class="absolute -bottom-8 -left-6 w-[88%] rounded-[--radius-card] border border-white/10 bg-white p-5 text-ink-900 shadow-2xl sm:-left-10 sm:p-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">7 caminhos de captação</p>
        <ul class="mt-3 grid grid-cols-1 gap-y-1.5 text-sm text-ink-500 sm:grid-cols-2 sm:gap-x-4">
          {caminhos.map((c) => (
            <li class="flex items-center gap-1.5">
              <span class="h-1 w-1 shrink-0 rounded-full bg-emerald-500"></span>
              {c}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .network-line {
    stroke-dasharray: 6 6;
  }
  .network-node {
    transform-origin: center;
    transform-box: fill-box;
  }

  @media (prefers-reduced-motion: no-preference) {
    .network-line {
      animation: network-dash-flow 8s linear infinite;
    }
    .network-node {
      animation: network-node-pulse 3s ease-in-out infinite;
    }
  }

  @keyframes network-dash-flow {
    to {
      stroke-dashoffset: -120;
    }
  }

  @keyframes network-node-pulse {
    0%,
    100% {
      opacity: 0.7;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.25);
    }
  }
</style>
