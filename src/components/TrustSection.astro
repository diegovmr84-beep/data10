---
import { Image } from 'astro:assets';
import ambienteImg from '../assets/images/ambiente-trabalho-organizado.jpg';

const pontos = [
  'Projeto bem feito, sem pressa, com cada exigência da fonte conferida antes do envio.',
  'Regra checada em fonte oficial — norma, edital ou lei, não em achismo.',
  'Acompanhamento até a prestação de contas, não só até a entrega do projeto.',
];
---

<section class="bg-navy-900 py-20 text-white sm:py-28">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
    <div data-reveal class="overflow-hidden rounded-[--radius-card] shadow-2xl">
      <Image
        src={ambienteImg}
        alt="Equipe reunida à mesa, analisando documentos com calma em ambiente de trabalho organizado e bem iluminado"
        widths={[480, 800, 1200]}
        sizes="(min-width: 1024px) 560px, 100vw"
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>

    <div data-reveal-group>
      <p data-reveal class="text-sm font-semibold uppercase tracking-widest text-emerald-400">Segurança e organização</p>
      <h2 data-reveal class="mt-3 max-w-md font-heading text-3xl font-bold leading-tight sm:text-4xl">
        Processo conduzido com calma, do jeito que dinheiro público e privado exige
      </h2>
      <ul class="mt-8 flex flex-col gap-5">
        {pontos.map((p) => (
          <li data-reveal class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-emerald-400" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
            <span class="text-white/85">{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
