---
const mecanismos = [
  { nome: 'Leis de incentivo à cultura e ao esporte', icon: 'scale' },
  { nome: 'Editais', icon: 'file' },
  { nome: 'Emendas parlamentares', icon: 'landmark' },
  { nome: 'Patrocínio', icon: 'handshake' },
  { nome: 'Crédito', icon: 'coins' },
];

const icons: Record<string, string> = {
  scale: 'M12 3v18M5 7l-3 7a4 4 0 0 0 8 0l-3-7Zm14 0l-3 7a4 4 0 0 0 8 0l-3-7ZM5 7h14M9 3h6',
  file: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6ZM14 2v6h6M9 13h6M9 17h6',
  landmark: 'M3 21h18M5 21V9m14 12V9M9 21V9m6 12V9M3 9l9-6 9 6M3 9h18',
  handshake: 'M8 12l3 3 7-7M3 11l4-4a2 2 0 0 1 3 0l1 1M21 11l-4-4a2 2 0 0 0-3 0l-1 1',
  coins: 'M8 8a5 2.5 0 1 0 10 0 5 2.5 0 1 0-10 0ZM3 8v8a5 2.5 0 0 0 10 0M8 16a5 2.5 0 0 0 10 0V8',
};
---

<section class="border-b border-border bg-white py-10">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="text-center text-xs font-semibold uppercase tracking-widest text-ink-500">Mecanismos com que trabalhamos</p>
    <div data-reveal-group class="mt-6 flex flex-wrap items-center justify-center gap-3">
      {mecanismos.map((m) => (
        <span data-reveal class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium text-ink-900">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600" aria-hidden="true"><path d={icons[m.icon]} /></svg>
          {m.nome}
        </span>
      ))}
    </div>
  </div>
</section>
