---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const whatsappNumber = '5583999596225';
const whatsappMessage = 'Olá! Vim pelo site da Data10 e gostaria de saber mais sobre os serviços.';
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<section class="bg-navy-900 py-20 text-white sm:py-24">
  <div data-reveal class="mx-auto max-w-2xl px-4 text-center sm:px-6">
    <h2 class="font-heading text-3xl font-bold sm:text-4xl">Pronto pra transformar sua ideia em recurso captado?</h2>
    <p class="mt-4 text-lg text-white/70">
      Fale com a gente agora pelo WhatsApp, ou use o formulário de contato se preferir.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 rounded-[--radius-control] bg-emerald-500 px-7 py-4 text-sm font-semibold text-navy-900 shadow-[0_8px_24px_rgba(16,185,129,0.35)] transition-colors hover:bg-emerald-600"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.76.46 3.48 1.34 5L2 22l5.14-1.35a9.96 9.96 0 0 0 4.9 1.25h.01c5.52 0 10-4.48 10-10s-4.48-10-10.01-10Zm0 18.17h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.05.8.82-2.97-.2-.3a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.16-8.32 8.16Zm4.52-6.13c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.8-.78.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.21-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42-.14 0-.31-.02-.47-.02-.17 0-.43.06-.66.31-.23.25-.86.84-.86 2.04 0 1.2.88 2.37 1 2.53.12.17 1.73 2.64 4.2 3.7.59.25 1.04.4 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29Z"/></svg>
        Falar no WhatsApp
      </a>
      <a
        href={`${base}/contato/`}
        class="inline-flex items-center rounded-[--radius-control] border border-white/30 px-7 py-4 text-sm font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/5"
      >
        Formulário de contato
      </a>
    </div>
  </div>
</section>
