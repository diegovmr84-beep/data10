---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const whatsappNumber = '5583999596225';
const email = 'diegovmr@protonmail.com';
---

<footer class="border-t border-white/10 bg-navy-900 text-white">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <div class="max-w-sm">
        <p class="font-heading text-xl font-extrabold">
          Data<span class="text-emerald-400">10</span>
        </p>
        <p class="mt-3 text-sm leading-relaxed text-white/60">
          Consultoria em produção de projetos para captação de recursos — lei de incentivo, recurso público,
          patrocínio, crédito e outras formas de captação — e criação de sites e aplicativos.
        </p>
        <p class="mt-5 text-sm text-white/50">João Pessoa / PB</p>
      </div>

      <div class="flex gap-10 text-sm">
        <div class="flex flex-col gap-2.5">
          <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-white/40">Navegação</p>
          <a href={`${base}/servicos-captacao/`} class="text-white/75 transition-colors hover:text-emerald-400">Captação de Recursos</a>
          <a href={`${base}/sistema/`} class="text-white/75 transition-colors hover:text-emerald-400">O Sistema</a>
          <a href={`${base}/sites-aplicativos/`} class="text-white/75 transition-colors hover:text-emerald-400">Sites e Aplicativos</a>
          <a href={`${base}/sobre/`} class="text-white/75 transition-colors hover:text-emerald-400">Sobre</a>
        </div>
        <div class="flex flex-col gap-2.5">
          <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-white/40">Contato</p>
          <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="text-white/75 transition-colors hover:text-emerald-400">
            WhatsApp
          </a>
          <a href={`mailto:${email}`} class="text-white/75 transition-colors hover:text-emerald-400">{email}</a>
          <a href={`${base}/privacidade/`} class="text-white/75 transition-colors hover:text-emerald-400">Política de Privacidade</a>
        </div>
      </div>
    </div>

    <p class="mt-10 border-t border-white/10 pt-6 text-xs text-white/40">
      &copy; {year} Data10. Todos os direitos reservados.
    </p>
  </div>
</footer>
