---
const etapas = [
  { numero: '01', titulo: 'Diagnóstico', body: 'Entendemos sua organização, seu projeto e qual mecanismo de captação (lei de incentivo, edital, emenda ou patrocínio) faz mais sentido.' },
  { numero: '02', titulo: 'Elaboração', body: 'Produzimos o projeto completo — justificativa, orçamento, cronograma e demais exigências do mecanismo escolhido.' },
  { numero: '03', titulo: 'Submissão e busca de apoio', body: 'Acompanhamos a submissão e, quando aplicável, a busca ativa por patrocinador ou apoiador.' },
  { numero: '04', titulo: 'Execução e prestação de contas', body: 'Damos suporte durante a execução do projeto e na prestação de contas exigida pelo mecanismo.' },
];
---

<section class="bg-white py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-700">Como funciona</p>
      <h2 class="mt-3 font-heading text-3xl font-bold text-ink-900 sm:text-4xl">Da sua ideia ao recurso captado, em quatro etapas</h2>
    </div>

    <div data-timeline class="relative mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {/* linha conectora — só visível em telas largas (lg), onde o layout é horizontal */}
      <div class="pointer-events-none absolute left-0 right-0 top-6 hidden h-0.5 bg-border lg:block" aria-hidden="true">
        <div data-timeline-fill class="h-full w-full bg-emerald-500 transition-[width] duration-700 ease-out"></div>
      </div>

      {etapas.map((e, i) => (
        <div data-timeline-step class="timeline-step relative flex flex-col gap-3">
          <div class="relative z-10 flex h-12 w-12 items-center justify-center rounded-full border-2 border-emerald-600 bg-white font-heading text-sm font-bold text-emerald-700">
            {e.numero}
          </div>
          <h3 class="font-heading text-base font-bold text-ink-900">{e.titulo}</h3>
          <p class="text-sm leading-relaxed text-ink-500">{e.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Estado "ativo" marcado via JS (ScrollReveal.astro) conforme a etapa entra
     na tela — sem JS/com redução de movimento, o círculo já nasce no estado
     normal (a cor emerald já indica a etapa, então nada fica sem sentido). */
  .timeline-step .z-10 {
    transition: background-color 0.4s ease, color 0.4s ease;
  }
  .timeline-step.is-active .z-10 {
    background-color: var(--color-emerald-500);
    color: white;
  }
</style>
