---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { posts } from '../../data/blog-posts.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sorted = [...posts].sort((a, b) => (a.date < b.date ? 1 : -1));

function formatDate(date: string) {
  return new Date(`${date}T00:00:00`).toLocaleDateString('pt-BR', {
    day: '2-digit',
    month: 'long',
    year: 'numeric',
  });
}
---

<BaseLayout
  title="Blog"
  description="Conteúdo sobre captação de recursos, leis de incentivo, editais, patrocínio e produção de projetos, pra você se atualizar e decidir o próximo passo do seu projeto."
>
  <PageHero
    eyebrow="Conteúdo"
    title="Blog"
    subtitle="Ideias, novidades e caminhos práticos sobre captação de recursos, pra você se atualizar e decidir o próximo passo do seu projeto."
  />

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div data-reveal-group class="grid gap-8 sm:grid-cols-2">
        {sorted.map((post) => (
          <a
            data-reveal
            href={`${base}/blog/${post.slug}/`}
            class="group flex flex-col overflow-hidden rounded-[--radius-card] border border-border bg-white shadow-sm transition-shadow hover:shadow-md"
          >
            {post.cover ? (
              <Image
                src={post.cover}
                alt={post.coverAlt ?? ''}
                widths={[400, 640, 900]}
                sizes="(min-width: 640px) 440px, 100vw"
                loading="lazy"
                class="aspect-[16/9] w-full object-cover"
              />
            ) : (
              <div class="flex aspect-[16/9] items-center justify-center bg-gradient-to-br from-navy-900 via-navy-800 to-emerald-700">
                <span class="font-heading text-xs font-semibold uppercase tracking-widest text-white/70">Data10 · Blog</span>
              </div>
            )}
            <div class="flex flex-1 flex-col p-6">
              <p class="text-xs font-medium text-ink-500">
                {formatDate(post.date)} · {post.readingMinutes} min de leitura
              </p>
              <h2 class="mt-2 font-heading text-lg font-bold text-ink-900 transition-colors group-hover:text-emerald-700">
                {post.title}
              </h2>
              <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-500">{post.excerpt}</p>
              <span class="mt-4 text-sm font-semibold text-emerald-700">Ler post →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
