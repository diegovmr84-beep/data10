---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const servicos = [
  {
    title: 'Leis de incentivo fiscal',
    body: 'Elaboração de projetos para captação via lei de incentivo (dedução de IR ou crédito de ICMS), nas esferas federal, estadual e municipal — cultura, esporte e outras áreas, como criança e adolescente, pessoa idosa, saúde e PCD.',
  },
  {
    title: 'Recurso público e editais',
    body: 'Levantamento de edital, chamamento público e subvenção compatíveis com o seu projeto, além de apoio na articulação de emenda parlamentar — com a proposta completa, dentro das exigências de cada fonte.',
  },
  {
    title: 'Patrocínio e captação privada',
    body: 'Busca ativa de patrocinador, apoiador e doador, com material de apresentação do projeto adequado ao público empresarial.',
  },
  {
    title: 'Crédito, investidores e renda própria',
    body: 'Orientação sobre linha de crédito, financiamento e, para empresa, captação com investidor — além de estratégia de geração de renda própria ligada à causa.',
  },
  {
    title: 'Habilitações e certificações',
    body: 'Apoio na obtenção de certidão, registro e certificado exigidos antes de captar — como CEBAS, OSCIP, registro em conselho ou a certidão da Lei Pelé.',
  },
  {
    title: 'Acompanhamento e prestação de contas',
    body: 'Suporte durante a execução do projeto e na prestação de contas exigida pelo mecanismo de captação utilizado.',
  },
];
---

<BaseLayout
  title="Captação de Recursos"
  description="Elaboração de projetos para lei de incentivo, recurso público, patrocínio, crédito e outras formas de captação, com acompanhamento e prestação de contas."
>
  <section class="border-b border-ink-100 bg-ink-950 text-white">
    <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
      <p class="text-sm font-semibold uppercase tracking-widest text-ember-400">Serviços</p>
      <h1 class="mt-4 font-serif-editorial text-3xl font-bold leading-tight sm:text-4xl">Captação de Recursos</h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-200">
        Produção de projetos completos para captação de recurso, do diagnóstico inicial até a prestação de contas
        — para OSCs, empresas e pessoas físicas. Veja também o <a href={`${base}/sistema/`} class="underline underline-offset-2 hover:text-white">Data10 Recursos</a>, nosso sistema com os 7 caminhos de captação mapeados.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-14 sm:px-6">
    <div class="flex flex-col gap-8">
      {servicos.map((s) => (
        <div class="border-b border-ink-100 pb-8 last:border-0">
          <h2 class="font-serif-editorial text-xl font-bold text-ink-950">{s.title}</h2>
          <p class="mt-2 text-ink-700">{s.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-lg bg-ink-50 p-8 text-center">
      <h2 class="font-serif-editorial text-xl font-bold text-ink-950">Quer saber se seu projeto se encaixa?</h2>
      <p class="mt-2 text-ink-700">Fale com a gente e vamos avaliar junto qual mecanismo de captação faz mais sentido.</p>
      <a href={`${base}/contato/`} class="mt-5 inline-block rounded bg-ember-500 px-5 py-3 font-medium text-white hover:bg-ember-600">
        Fale conosco
      </a>
    </div>
  </section>
</BaseLayout>
