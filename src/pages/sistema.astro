---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sistemaUrl = 'https://recursos.data10.app.br';

const etapas = [
  { n: 'Etapa 1', titulo: 'Grupo', body: 'O tipo de dinheiro que você busca: imposto, público, privado, renda própria, crédito, investidores ou habilitações e certificações.' },
  { n: 'Etapa 2', titulo: 'Forma', body: 'A fonte específica (Lei de Incentivo, Rouanet, FIA, Pronampe…), com semáforo de elegibilidade e prazos.' },
  { n: 'Etapa 3', titulo: 'Dados', body: 'Só as perguntas que aquela forma exige; o resto vem do seu perfil e de projetos anteriores.' },
  { n: 'Etapa 4', titulo: 'Produção', body: 'Texto seção por seção, orçamento com as regras da norma e validações antes de exportar.' },
  { n: 'Etapa 5', titulo: 'Entrega', body: 'Arquivos .docx/.xlsx, texto para colar no sistema oficial e simuladores para a conversa de captação.' },
];

const caminhos = [
  {
    id: 1,
    nome: 'Dinheiro de imposto',
    descricao: 'Empresas e pessoas destinam parte do imposto devido ao seu projeto por meio das leis de incentivo fiscal (dedução do IR ou crédito de ICMS).',
    publico: ['OSC', 'Empresa', 'Pessoa física'],
    exemplos: 'Lei de Incentivo ao Esporte, Lei Rouanet, Fundo dos Direitos da Criança e do Adolescente, Fundo da Pessoa Idosa, PRONON, PRONAS/PCD, ICMS Cultural da Paraíba, Lei de Incentivo à Reciclagem',
  },
  {
    id: 2,
    nome: 'Recurso público a fundo perdido',
    descricao: 'Recursos não reembolsáveis do poder público e das fundações de amparo à pesquisa, por emenda parlamentar, chamamento público e editais de subvenção.',
    publico: ['OSC', 'Empresa', 'Pessoa física'],
    exemplos: 'Emenda parlamentar, termo de fomento e termo de colaboração, editais de fomento à cultura e da PNAB, creche ou escola conveniada ao Fundeb, edital FAPESQ com EMBRAPII, subvenção econômica à inovação, BNDES Periferias Fortes',
  },
  {
    id: 3,
    nome: 'Dinheiro privado sem incentivo fiscal',
    descricao: 'Investimento social privado sem incentivo fiscal: editais de institutos e fundações, patrocínio, doações, eventos e crowdfunding.',
    publico: ['OSC', 'Empresa'],
    exemplos: 'Editais de institutos e fundações, patrocínio, doadores recorrentes, crowdfunding, eventos, cooperação internacional',
  },
  {
    id: 4,
    nome: 'Renda própria',
    descricao: 'A organização ganha dinheiro vendendo produtos ou serviços ligados à sua causa.',
    publico: ['OSC', 'Empresa'],
    exemplos: 'Loja, bazar, serviços, eventos pagos, licenciamento de marca e contratos com o poder público, como PNAE e PAA',
  },
  {
    id: 5,
    nome: 'Crédito',
    descricao: 'Empréstimos e financiamentos com condições especiais. O dinheiro precisa ser devolvido, com juros.',
    publico: ['Empresa', 'OSC', 'Pessoa física'],
    exemplos: 'Pronampe, crédito do FNE no Banco do Nordeste, Empreender Paraíba, BNDES por agente financeiro, crédito em cooperativa, microcrédito orientado, antecipação de recebíveis',
  },
  {
    id: 6,
    nome: 'Investidores',
    descricao: 'Pessoas ou fundos colocam dinheiro na empresa em troca de participação ou de retorno financeiro.',
    publico: ['Empresa'],
    exemplos: 'Investimento-anjo, venture capital, investimento de impacto, crowdfunding de investimento',
  },
  {
    id: 7,
    nome: 'Habilitações e certificações',
    descricao: 'Certificados, registros em conselhos e certidões que a lei ou o edital exige da organização antes de ela poder receber recursos nas outras formas de captação.',
    publico: ['OSC', 'Empresa', 'Pessoa física'],
    exemplos: 'Certidão de Registro Cadastral da Lei Pelé, CEBAS, registro no CMDCA, inscrição no CMAS, estatuto adequado ao MROSC, certidões de regularidade, OSCIP, Organização Social, Ponto de Cultura',
  },
];

const confianca = [
  { titulo: 'Regra com fonte', body: 'Cada limite traz a norma, o artigo e a data em que foi conferido em fonte oficial. O que não foi confirmado aparece marcado.' },
  { titulo: 'Prazos em dia', body: 'Janelas, validade de certidões e revisões calculadas a partir da data de hoje, com aviso antes de vencer.' },
  { titulo: 'Validação antes de enviar', body: 'Tetos, percentuais e vedações conferidos no orçamento e no texto: o arquivo só sai sem pendência bloqueante.' },
  { titulo: 'Sem promessa de aprovação', body: 'O sistema prepara o melhor projeto possível; a decisão é sempre do órgão, do financiador ou do investidor.' },
];
---

<BaseLayout
  title="O Sistema — Data10 Recursos"
  description="Data10 Recursos: a plataforma que mostra os caminhos de captação disponíveis para sua organização, confere as regras em fonte oficial e produz o projeto pronto para enviar."
>
  <section class="relative overflow-hidden bg-navy-900 pb-14 pt-32 text-white sm:pb-20 sm:pt-40">
    <div class="pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="sistema-hero-grid" width="56" height="56" patternUnits="userSpaceOnUse">
            <path d="M 56 0 L 0 0 0 56" fill="none" stroke="white" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#sistema-hero-grid)"/>
      </svg>
    </div>
    <div data-reveal class="relative mx-auto max-w-4xl px-4 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-emerald-400">Produto</p>
      <h1 class="mt-4 font-heading text-3xl font-extrabold leading-tight sm:text-4xl">Data10 Recursos</h1>
      <p class="mt-2 text-lg font-medium text-emerald-300">Produtor de Projetos — do objetivo ao projeto pronto para captar</p>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-white/75">
        Diga o que a sua organização precisa. O sistema mostra os caminhos de captação possíveis, confere as regras
        em fonte oficial e conduz você, etapa por etapa, até o documento no formato que cada fonte exige.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={sistemaUrl} target="_blank" rel="noopener noreferrer" class="rounded-[--radius-control] bg-emerald-500 px-6 py-3.5 text-sm font-semibold text-navy-900 shadow-[0_8px_24px_rgba(16,185,129,0.35)] transition-colors hover:bg-emerald-600">
          Acessar o sistema
        </a>
        <a href={`${base}/contato/`} class="rounded-[--radius-control] border border-white/30 px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/5">
          Falar sobre o sistema
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <h2 class="font-heading text-2xl font-bold text-ink-900 sm:text-3xl">Como funciona</h2>
      <p class="mt-2 max-w-2xl text-ink-500">
        O mesmo percurso vale para qualquer forma de captação, do incentivo fiscal ao crédito. Você pode voltar a
        qualquer etapa para ajustar.
      </p>
      <div data-reveal-group class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {etapas.map((e) => (
          <div data-reveal class="rounded-[--radius-card] border border-border bg-surface p-5 transition-shadow hover:shadow-md">
            <p class="text-xs font-semibold uppercase tracking-wide text-emerald-700">{e.n}</p>
            <h3 class="mt-1 font-heading font-bold text-ink-900">{e.titulo}</h3>
            <p class="mt-2 text-sm text-ink-500">{e.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-surface py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <h2 class="font-heading text-2xl font-bold text-ink-900 sm:text-3xl">Os 7 caminhos para captar</h2>
      <p class="mt-2 max-w-2xl text-ink-500">
        Escolha pelo tipo de recurso, não pela lei: dentro de cada caminho o sistema mostra as formas disponíveis
        para o seu perfil.
      </p>
      <div data-reveal-group class="mt-8 grid gap-5 sm:grid-cols-2">
        {caminhos.map((c) => (
          <div data-reveal class="rounded-[--radius-card] border border-border bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
            <p class="text-xs font-semibold text-ink-500/70">Caminho {c.id}</p>
            <h3 class="mt-1 font-heading text-lg font-bold text-ink-900">{c.nome}</h3>
            <p class="mt-2 text-sm text-ink-500">{c.descricao}</p>
            <p class="mt-3 text-xs text-ink-500"><strong class="text-ink-900">Exemplos:</strong> {c.exemplos}</p>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {c.publico.map((p) => (
                <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">{p}</span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <h2 class="font-heading text-2xl font-bold text-ink-900 sm:text-3xl">Por que confiar</h2>
      <p class="mt-2 max-w-2xl text-ink-500">Captação é dinheiro com regra. O sistema foi feito para não deixar você errar o que é objetivo.</p>
      <div data-reveal-group class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {confianca.map((c) => (
          <div data-reveal>
            <h3 class="font-heading font-bold text-ink-900">{c.titulo}</h3>
            <p class="mt-2 text-sm text-ink-500">{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-navy-900 py-16 text-center text-white sm:py-20">
    <div data-reveal class="mx-auto max-w-2xl px-4 sm:px-6">
      <h2 class="font-heading text-2xl font-bold sm:text-3xl">Consultoria ou sistema, ou os dois</h2>
      <p class="mt-3 text-white/70">
        Você pode usar o Data10 Recursos por conta própria, ou contar com a <a href={`${base}/servicos-captacao/`} class="font-medium text-emerald-400 underline underline-offset-2 hover:text-emerald-300">consultoria completa</a> pra conduzir o processo junto com você.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href={sistemaUrl} target="_blank" rel="noopener noreferrer" class="rounded-[--radius-control] bg-emerald-500 px-6 py-3 font-semibold text-navy-900 transition-colors hover:bg-emerald-600">
          Acessar o sistema
        </a>
        <a href={`${base}/contato/`} class="rounded-[--radius-control] border border-white/30 px-6 py-3 font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/5">
          Fale conosco
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
