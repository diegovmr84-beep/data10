---
import BaseLayout from '../layouts/BaseLayout.astro';

const whatsappNumber = '5583999596225';
const whatsappMessage = 'Olá! Vim pelo site da Data10 e gostaria de saber mais sobre os serviços.';
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
const email = 'diegovmr@protonmail.com';
---

<BaseLayout
  title="Contato"
  description="Fale com a Data10 pelo WhatsApp, e-mail ou formulário de contato. Atendimento em João Pessoa/PB e remoto para todo o Brasil."
>
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <h1 class="font-serif-editorial text-3xl font-bold text-ink-950 sm:text-4xl">Contato</h1>
    <p class="mt-3 text-ink-700">
      O jeito mais rápido de falar com a gente é pelo WhatsApp. Se preferir, use o formulário abaixo ou mande um
      e-mail direto.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-1 items-center justify-center gap-2 rounded bg-[#25D366] px-5 py-3 font-medium text-white hover:brightness-95"
      >
        Chamar no WhatsApp
      </a>
      <a
        href={`mailto:${email}`}
        class="flex flex-1 items-center justify-center gap-2 rounded border border-ink-300 px-5 py-3 font-medium text-ink-900 hover:border-ink-500"
      >
        {email}
      </a>
    </div>

    <div class="mt-12 border-t border-ink-100 pt-10">
      <h2 class="font-serif-editorial text-xl font-bold text-ink-950">Ou envie uma mensagem</h2>
      <p class="mt-2 text-sm text-ink-600">
        Este formulário abre seu aplicativo de e-mail com a mensagem pronta para enviar — não envia nada
        automaticamente sem a sua confirmação.
      </p>

      <form action={`mailto:${email}`} method="post" enctype="text/plain" class="mt-6 flex flex-col gap-4">
        <div>
          <label for="nome" class="mb-1 block text-sm font-medium text-ink-800">Nome</label>
          <input
            type="text"
            id="nome"
            name="Nome"
            required
            class="w-full rounded border border-ink-200 px-4 py-2.5 text-ink-950 focus:border-ember-400 focus:outline-none"
          />
        </div>
        <div>
          <label for="email-contato" class="mb-1 block text-sm font-medium text-ink-800">E-mail</label>
          <input
            type="email"
            id="email-contato"
            name="Email"
            required
            class="w-full rounded border border-ink-200 px-4 py-2.5 text-ink-950 focus:border-ember-400 focus:outline-none"
          />
        </div>
        <div>
          <label for="mensagem" class="mb-1 block text-sm font-medium text-ink-800">Mensagem</label>
          <textarea
            id="mensagem"
            name="Mensagem"
            rows="5"
            required
            class="w-full rounded border border-ink-200 px-4 py-2.5 text-ink-950 focus:border-ember-400 focus:outline-none"
          ></textarea>
        </div>
        <button
          type="submit"
          class="self-start rounded bg-ember-500 px-5 py-3 font-medium text-white hover:bg-ember-600"
        >
          Preparar e-mail
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
