---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const whatsappNumber = '5583999596225';
const whatsappMessage = 'Olá! Vim pelo site da Data10 e gostaria de saber mais sobre os serviços.';
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
const email = 'diegovmr@protonmail.com';
---

<BaseLayout
  title="Contato"
  description="Fale com a Data10 pelo WhatsApp, e-mail ou formulário de contato. Atendimento em João Pessoa/PB e remoto para todo o Brasil."
>
  <PageHero
    eyebrow="Fale conosco"
    title="Contato"
    subtitle="O jeito mais rápido de falar conosco é pelo WhatsApp. Se preferir, use o formulário abaixo ou mande um e-mail direto."
  />

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-2xl px-4 sm:px-6">
      <div data-reveal-group class="flex flex-col gap-3 sm:flex-row">
        <a
          data-reveal
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-1 items-center justify-center gap-2 rounded-[--radius-control] bg-[#25D366] px-5 py-3.5 font-semibold text-white shadow-sm transition-transform hover:scale-[1.02]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.52 0-10 4.48-10 10 0 1.76.46 3.48 1.34 5L2 22l5.14-1.35a9.96 9.96 0 0 0 4.9 1.25h.01c5.52 0 10-4.48 10-10s-4.48-10-10.01-10Zm0 18.17h-.01a8.2 8.2 0 0 1-4.17-1.14l-.3-.18-3.05.8.82-2.97-.2-.3a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.16-8.32 8.16Zm4.52-6.13c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.8-.78.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.21-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42-.14 0-.31-.02-.47-.02-.17 0-.43.06-.66.31-.23.25-.86.84-.86 2.04 0 1.2.88 2.37 1 2.53.12.17 1.73 2.64 4.2 3.7.59.25 1.04.4 1.4.52.59.19 1.12.16 1.54.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29Z"/></svg>
          Chamar no WhatsApp
        </a>
        <a
          data-reveal
          href={`mailto:${email}`}
          class="flex flex-1 items-center justify-center gap-2 rounded-[--radius-control] border border-border px-5 py-3.5 font-semibold text-ink-900 transition-colors hover:border-emerald-600 hover:text-emerald-700"
        >
          {email}
        </a>
      </div>

      <div data-reveal class="mt-14 rounded-[--radius-card] border border-border bg-surface p-8">
        <h2 class="font-heading text-xl font-bold text-ink-900">Ou envie uma mensagem</h2>
        <p class="mt-2 text-sm text-ink-500">
          Este formulário abre seu aplicativo de e-mail com a mensagem pronta para enviar — não envia nada
          automaticamente sem a sua confirmação.
        </p>

        <form action={`mailto:${email}`} method="post" enctype="text/plain" class="mt-6 flex flex-col gap-4">
          <div>
            <label for="nome" class="mb-1.5 block text-sm font-medium text-ink-900">Nome</label>
            <input
              type="text"
              id="nome"
              name="Nome"
              required
              class="w-full rounded-[--radius-control] border border-border bg-white px-4 py-2.5 text-ink-900 focus:border-emerald-500 focus:outline-none"
            />
          </div>
          <div>
            <label for="email-contato" class="mb-1.5 block text-sm font-medium text-ink-900">E-mail</label>
            <input
              type="email"
              id="email-contato"
              name="Email"
              required
              class="w-full rounded-[--radius-control] border border-border bg-white px-4 py-2.5 text-ink-900 focus:border-emerald-500 focus:outline-none"
            />
          </div>
          <div>
            <label for="mensagem" class="mb-1.5 block text-sm font-medium text-ink-900">Mensagem</label>
            <textarea
              id="mensagem"
              name="Mensagem"
              rows="5"
              required
              class="w-full rounded-[--radius-control] border border-border bg-white px-4 py-2.5 text-ink-900 focus:border-emerald-500 focus:outline-none"
            ></textarea>
          </div>
          <button
            type="submit"
            class="self-start rounded-[--radius-control] bg-emerald-500 px-6 py-3 font-semibold text-navy-900 transition-colors hover:bg-emerald-600"
          >
            Preparar e-mail
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
