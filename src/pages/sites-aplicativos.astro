---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import equipeImg from '../assets/images/equipe-escritorio-digital.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const itens = [
  {
    title: 'Sites institucionais',
    body: 'Para pessoa jurídica ou pessoa física que precisa de presença digital profissional, com painel para você gerenciar o próprio conteúdo depois da entrega, sem depender de nós para cada atualização.',
  },
  {
    title: 'Gestão do projeto',
    body: 'Painel para acompanhar cronograma, documentos e etapas da elaboração e execução do seu projeto, construído sob medida para o jeito que a sua equipe trabalha.',
  },
  {
    title: 'Gestão do recurso recebido',
    body: 'Aplicativo para controlar o uso do recurso captado, com registro de gastos organizado do jeito que a prestação de contas exige.',
  },
  {
    title: 'Prestação de contas',
    body: 'Ferramenta para organizar a documentação e montar o relatório de prestação de contas, reduzindo retrabalho na hora de fechar o processo.',
  },
];
---

<BaseLayout
  title="Sites e Aplicativos"
  description="Criação de sites e aplicativos sob medida para apoiar o seu projeto em cada etapa, da elaboração à prestação de contas, com treinamento para você usar por conta própria."
>
  <PageHero
    eyebrow="Serviços"
    title="Sites e Aplicativos"
    subtitle="Ferramentas sob medida para apoiar o seu projeto em cada etapa, da elaboração à gestão do recurso recebido e à prestação de contas, com treinamento para você usar por conta própria."
  />
  <p class="mx-auto -mt-6 max-w-4xl px-4 pb-2 text-sm text-ink-500 sm:px-6">
    É diferente do <a href={`${base}/sistema/`} class="font-medium text-emerald-700 underline underline-offset-2 hover:text-emerald-800">Data10 Recursos</a>: o sistema ajuda a mapear o caminho de captação e produzir o projeto. Aqui, construímos sob medida para apoiar você depois, na execução, na gestão do recurso e na prestação de contas.
  </p>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto grid max-w-5xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-2 lg:gap-16">
      <div data-reveal-group class="order-2 lg:order-1">
        <p data-reveal class="text-sm font-semibold uppercase tracking-widest text-emerald-700">Como entregamos</p>
        <h2 data-reveal class="mt-3 font-heading text-2xl font-bold text-ink-900 sm:text-3xl">
          Projeto digital do primeiro rascunho à publicação
        </h2>
        <p data-reveal class="mt-4 leading-relaxed text-ink-500">
          Cuidamos de cada etapa, da estrutura ao conteúdo, e deixamos tudo pronto para você usar sozinho
          depois. Em toda entrega, incluímos o treinamento para a sua equipe operar a ferramenta com autonomia.
        </p>
      </div>
      <div data-reveal class="order-1 overflow-hidden rounded-[--radius-card] shadow-lg lg:order-2">
        <Image
          src={equipeImg}
          alt="Equipe trabalhando em notebook e ao telefone em escritório moderno, discutindo um projeto digital"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 480px, 100vw"
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <section class="bg-surface py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div data-reveal-group class="grid gap-6 sm:grid-cols-2">
        {itens.map((item) => (
          <div data-reveal class="rounded-[--radius-card] border border-border bg-white p-7 shadow-sm transition-shadow hover:shadow-md">
            <h2 class="font-heading text-lg font-bold text-ink-900">{item.title}</h2>
            <p class="mt-2.5 text-sm leading-relaxed text-ink-500">{item.body}</p>
          </div>
        ))}
      </div>

      <div data-reveal class="mt-10 rounded-[--radius-card] bg-navy-900 p-10 text-center text-white">
        <h2 class="font-heading text-xl font-bold">Quer uma ferramenta pra apoiar seu projeto do início ao fim?</h2>
        <p class="mt-2 text-white/70">Conte pra nós o que você precisa e avaliamos juntos o melhor caminho.</p>
        <a href={`${base}/contato/`} class="mt-6 inline-block rounded-[--radius-control] bg-emerald-500 px-6 py-3 font-semibold text-navy-900 transition-colors hover:bg-emerald-600">
          Fale conosco
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
