---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  readingMinutes: number;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const { title, description, date, readingMinutes, cover, coverAlt } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const dateFormatted = new Date(`${date}T00:00:00`).toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date,
  author: {
    '@type': 'Person',
    name: 'Diego Valois da Mota Ribeiro',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Data10',
  },
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article>
    <section class="relative overflow-hidden bg-navy-900 pb-10 pt-32 text-white sm:pb-14 sm:pt-40">
      <div class="pointer-events-none absolute inset-0 opacity-[0.07]" aria-hidden="true">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="blog-post-grid" width="56" height="56" patternUnits="userSpaceOnUse">
              <path d="M 56 0 L 0 0 0 56" fill="none" stroke="white" stroke-width="1" />
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#blog-post-grid)" />
        </svg>
      </div>
      <div data-reveal class="relative mx-auto max-w-3xl px-4 sm:px-6">
        <a href={`${base}/blog/`} class="text-sm font-semibold text-emerald-400 transition-colors hover:text-emerald-300">
          &larr; Blog
        </a>
        <p class="mt-5 text-sm font-medium text-white/60">{dateFormatted} · {readingMinutes} min de leitura</p>
        <h1 class="mt-3 max-w-2xl font-heading text-3xl font-extrabold leading-tight sm:text-4xl">{title}</h1>
      </div>
    </section>

    <div class="mx-auto -mt-8 max-w-4xl px-4 sm:px-6">
      {cover ? (
        <div class="overflow-hidden rounded-[--radius-card] shadow-xl">
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            widths={[640, 1000, 1400]}
            sizes="(min-width: 1024px) 896px, 100vw"
            loading="eager"
            class="h-auto w-full object-cover"
          />
        </div>
      ) : (
        <div class="flex aspect-[16/7] items-center justify-center rounded-[--radius-card] bg-gradient-to-br from-navy-900 via-navy-800 to-emerald-700 shadow-xl">
          <span class="font-heading text-sm font-semibold uppercase tracking-widest text-white/70">Data10 · Blog</span>
        </div>
      )}
    </div>

    <div class="bg-white py-14 sm:py-16">
      <div data-reveal-group class="prose-blog mx-auto max-w-2xl px-4 sm:px-6">
        <slot />
      </div>
    </div>

    <div class="bg-surface pb-20 pt-4 sm:pb-24">
      <div data-reveal class="mx-auto max-w-2xl rounded-[--radius-card] bg-navy-900 p-10 text-center text-white">
        <h2 class="font-heading text-xl font-bold">Quer avaliar o melhor caminho pro seu projeto?</h2>
        <p class="mt-2 text-white/70">Conte pra nós a sua ideia e vemos juntos qual caminho de captação se encaixa.</p>
        <a
          href={`${base}/contato/`}
          class="mt-6 inline-block rounded-[--radius-control] bg-emerald-500 px-6 py-3 font-semibold text-navy-900 transition-colors hover:bg-emerald-600"
        >
          Fale conosco
        </a>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .prose-blog :global(h2) {
    margin-top: 2.25rem;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-ink-900);
  }

  .prose-blog :global(h3) {
    margin-top: 1.75rem;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-ink-900);
  }

  .prose-blog :global(p) {
    margin-top: 1.1rem;
    line-height: 1.75;
    color: var(--color-ink-500);
  }

  .prose-blog :global(ul) {
    margin-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .prose-blog :global(li) {
    line-height: 1.7;
    color: var(--color-ink-500);
  }

  .prose-blog :global(li)::marker {
    color: var(--color-emerald-600);
  }

  .prose-blog :global(a) {
    color: var(--color-emerald-700);
    font-weight: 500;
    text-underline-offset: 2px;
  }

  .prose-blog :global(strong) {
    color: var(--color-ink-900);
    font-weight: 600;
  }
</style>
