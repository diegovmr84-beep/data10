---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ogDefaultSvg from '../assets/og-default.svg';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  noIndex?: boolean;
}

const {
  title,
  description,
  image,
  imageWidth,
  imageHeight,
  noIndex = false,
} = Astro.props;

const siteName = 'Data10';
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// X/Twitter (e outros crawlers de card social) não aceitam SVG como imagem
// de preview — geramos uma versão PNG da imagem padrão a partir do SVG
// autoral, só para essa finalidade.
const ogDefaultPng = await getImage({ src: ogDefaultSvg, format: 'png', width: 1200, height: 630 });
const ogImage = image ? new URL(image, Astro.site).toString() : new URL(ogDefaultPng.src, Astro.site).toString();
const ogImageWidth = image ? (imageWidth ?? 1200) : ogDefaultPng.attributes.width;
const ogImageHeight = image ? (imageHeight ?? 630) : ogDefaultPng.attributes.height;

// Dados estruturados schema.org — ajuda buscadores a entender que este é
// um negócio de serviço profissional, com dado de contato e área de atuação.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Data10',
  description:
    'Consultoria em produção de projetos para captação de recursos — leis de incentivo, editais, emendas parlamentares e patrocínio — além de criação de sites e aplicativos.',
  url: 'https://data10.app.br',
  telephone: '+5583999596225',
  email: 'diegovmr@protonmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'João Pessoa',
    addressRegion: 'PB',
    addressCountry: 'BR',
  },
  founder: {
    '@type': 'Person',
    name: 'Diego Valois da Mota Ribeiro',
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-adsense-account" content="ca-pub-8302966077337193" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700;8..60,900&family=Inter:wght@400;500;600;700&display=swap"
    />

    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="pt_BR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <Analytics />
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink-950">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-ink-950 focus:px-3 focus:py-2 focus:text-white">
      Pular para o conteúdo
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent privacyHref={`${base}/privacidade/`} />
    <WhatsAppButton />
  </body>
</html>
